{
  "coordinator-hooks": {
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file|multi_replace_file_content|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./hooks/coordinator-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./hooks/merge-reminder.sh",
            "timeout": 45
          }
        ]
      },
      {
        "matcher": "send_message|swarm",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./hooks/ag-chain.sh post next-sent.sh report-sent.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "bash ./hooks/ag-chain.sh prompt ci-watch-reminder.sh rotation-guard.sh:prompt",
        "timeout": 40
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "bash ./hooks/session-start.sh"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "bash ./hooks/ag-chain.sh stop next-guard.sh rotation-guard.sh:stop report-guard.sh",
        "timeout": 60
      }
    ]
  }
}
