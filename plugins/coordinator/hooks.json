{
  "coordinator-hooks": {
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file|multi_replace_file_content|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./hooks/coordinator-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./hooks/merge-reminder.sh",
            "timeout": 45
          }
        ]
      },
      {
        "matcher": "send_message|swarm",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./hooks/next-sent.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "bash ./hooks/ci-watch-reminder.sh",
        "timeout": 10
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "bash ./hooks/session-start.sh"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "bash ./hooks/next-guard.sh",
        "timeout": 10
      }
    ]
  }
}
